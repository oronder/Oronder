<div class="oronder-settings standard-form scrollable">
    {{#if guild}}
        <fieldset>
            <legend>{{localize "oronder.Game"}}</legend>
            <div class="form-group">
                <label for="gm_xp">{{localize "oronder.GM-XP"}}</label>
                <div class="form-fields">
                    <input type="text" inputmode="numeric" id="gm_xp" name="gm_xp" value="{{guild.gm_xp}}">
                </div>
                <p class="hint">{{localize "oronder.GM-XP-Label"}}</p>
            </div>
            <div class="form-group">
                <label for="starting_level">{{localize "oronder.Starting-Level"}}</label>
                <div class="form-fields">
                    <input type="text" inputmode="numeric" id="starting_level" name="starting_level"
                           value="{{guild.starting_level}}">
                </div>
                <p class="hint">{{localize "oronder.Starting-Level-Label"}}</p>
            </div>
            <div class="form-group">
                <label for="timezone">{{localize "oronder.Timezone"}}</label>
                <div class="form-fields">
                    <select id="timezone" name="timezone">
                        {{#each timezones}}
                            <option value="{{this}}" {{#if (eq this ../guild.timezone)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "oronder.Timezone-Label"}}</p>
            </div>
        </fieldset>

        <fieldset>
            <legend>Discord</legend>
            <div class="form-group">
                <label for="gm_role">{{localize "oronder.GM-Role"}}</label>
                <div class="form-fields">
                    <select id="gm_role" name="gm_role">
                        {{#each guild.roles}}
                            <option value="{{id}}" {{#if (eq id ../guild.gm_role_id)}}selected{{/if}}>{{name}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "oronder.GM-Role-Label"}}</p>
            </div>
            <div class="form-group">
                <label for="subscription">
                    <a href="https://discord.gg/Adg48Xrs6K">{{localize "oronder.Discord-Status"}}</a>
                </label>
                <div class="form-fields">
                    <input type="text" disabled id="subscription" name="subscription" value="{{guild.subscription}}">
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>{{localize "oronder.Channels"}}</legend>
            <div class="form-group">
                <label for="session_channel">{{localize "oronder.Session-Channel"}}</label>
                <div class="form-fields">
                    <select id="session_channel" name="session_channel">
                        {{#each guild.forum_and_text_channels}}
                            <option value="{{id}}" {{#if (eq id ../guild.session_channel_id)}}selected{{/if}}>{{name}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "oronder.Session-Channel-Label"}}</p>
            </div>
            <div class="form-group">
                <label for="downtime_channel">{{localize "oronder.Downtime-Channel"}}</label>
                <div class="form-fields">
                    <select id="downtime_channel" name="downtime_channel">
                        {{#each guild.text_channels}}
                            <option value="{{id}}" {{#if (eq id ../guild.downtime_channel_id)}}selected{{/if}}>{{name}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "oronder.Downtime-Channel-Label"}}</p>
            </div>
            <div class="form-group">
                <label for="downtime_gm_channel">{{localize "oronder.Downtime-GM-Channel"}}</label>
                <div class="form-fields">
                    <select id="downtime_gm_channel" name="downtime_gm_channel">
                        <option value="">❌ {{localize "oronder.DISABLED"}}</option>
                        {{#each guild.text_channels}}
                            <option value="{{id}}" {{#if (eq id ../guild.downtime_gm_channel_id)}}selected{{/if}}>{{name}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "oronder.Downtime-GM-Channel-Label"}}</p>
            </div>
            <div class="form-group">
                <label for="voice_channel">{{localize "oronder.Voice-Channel"}}</label>
                <div class="form-fields">
                    <select id="voice_channel" name="voice_channel">
                        {{#each guild.voice_and_stage_channels}}
                            <option value="{{id}}" {{#if (eq id ../guild.voice_channel_id)}}selected{{/if}}>{{name}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "oronder.Voice-Channel-Label"}}</p>
            </div>
            <div class="form-group">
                <label for="scheduling_channel">{{localize "oronder.Scheduling-Channel"}}</label>
                <div class="form-fields">
                    <select id="scheduling_channel" name="scheduling_channel">
                        {{#each guild.text_channels}}
                            <option value="{{id}}" {{#if (eq id ../guild.scheduling_channel_id)}}selected{{/if}}>{{name}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "oronder.Scheduling-Channel-Label"}}</p>
            </div>
        </fieldset>

        <fieldset>
            <legend>{{localize "oronder.Foundry-to-Discord-Ids"}}</legend>
            {{#each players}}
                <div class="form-group">
                    <label for="{{foundry_id}}">{{foundry_name}}</label>
                    <div class="form-fields">
                        <select id="{{foundry_id}}" name="{{foundry_id}}">
                            <option value=""></option>
                            {{#each ../guild.members}}
                                <option value="{{id}}" {{#if (eq id ../discord_id)}}selected{{/if}}>{{name}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
            {{else}}
                <p class="hint">{{localize "oronder.No-Players-Found"}}</p>
            {{/each}}
        </fieldset>

        <fieldset>
            <legend>{{localize "oronder.Rollcall"}}</legend>
            <div class="form-group">
                <label for="rollcall_enabled">{{localize "oronder.Rollcall"}}</label>
                <div class="form-fields">
                    <input type="checkbox" id="rollcall_enabled" name="rollcall_enabled" data-action="toggle"
                        {{checked guild.rollcall_enabled}}>
                </div>
                <p class="hint">{{localize "oronder.Rollcall-Label"}}</p>
            </div>
            {{#if guild.rollcall_enabled}}
                <div class="form-group">
                    <label for="rollcall_role">{{localize "oronder.Role"}}</label>
                    <div class="form-fields">
                        <select id="rollcall_role" name="rollcall_role" required>
                            <option value=""></option>
                            {{#each guild.roles}}
                                <option value="{{id}}" {{#if (eq id ../guild.rollcall_role_id)}}selected{{/if}}>{{name}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <p class="hint">{{localize "oronder.Rollcall-Role-Label"}}</p>
                </div>
                <div class="form-group">
                    <label for="rollcall_channel">{{localize "oronder.Channel"}}</label>
                    <div class="form-fields">
                        <select id="rollcall_channel" name="rollcall_channel" required>
                            <option value=""></option>
                            {{#each guild.text_channels}}
                                <option value="{{id}}" {{#if (eq id ../guild.rollcall_channel_id)}}selected{{/if}}>{{name}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <p class="hint">{{localize "oronder.Rollcall-Channel-Label"}}</p>
                </div>
                <div class="form-group">
                    <label for="rollcall_day">{{localize "oronder.Day"}}</label>
                    <div class="form-fields">
                        <select id="rollcall_day" name="rollcall_day" required>
                            <option value=""></option>
                            {{#each days_of_week}}
                                <option value="{{this}}" {{#if (eq this ../guild.rollcall_day)}}selected{{/if}}>{{this}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <p class="hint">{{localize "oronder.Rollcall-Day-Label"}}</p>
                </div>
                <div class="form-group">
                    <label for="rollcall_time">{{localize "oronder.Time"}}</label>
                    <div class="form-fields">
                        <input type="time" id="rollcall_time" name="rollcall_time" required value="{{guild.rollcall_time}}">
                    </div>
                    <p class="hint">{{localize "oronder.Rollcall-Time-Label"}}</p>
                </div>
            {{/if}}
        </fieldset>

        <fieldset>
            <legend>{{localize "oronder.Advanced-Options"}}</legend>
            <div class="form-group">
                <label for="roll_discord_to_foundry">{{localize "oronder.Publish-Discord-Rolls-To-Foundry"}}</label>
                <div class="form-fields">
                    <input type="checkbox" id="roll_discord_to_foundry" name="roll_discord_to_foundry"
                           data-action="toggle" {{checked guild.roll_discord_to_foundry}}>
                </div>
                <p class="hint">{{localize "oronder.Publish-Discord-Rolls-To-Foundry-Label"}}</p>
            </div>
            <div class="form-group">
                <label for="combat_tracking_enabled">{{localize "oronder.Combat-Tracking-Enable"}}</label>
                <div class="form-fields">
                    <input type="checkbox" id="combat_tracking_enabled" name="combat_tracking_enabled"
                           data-action="toggle" {{checked combat_tracking_enabled}}>
                </div>
                <p class="hint">{{localize "oronder.Combat-Tracking-Enable-Label"}}</p>
            </div>
            <div class="form-group">
                <label for="combat_channel">{{localize "oronder.Combat-Channel"}}</label>
                <div class="form-fields">
                    <select id="combat_channel" name="combat_channel" {{#unless combat_tracking_enabled}}disabled{{/unless}}>
                        {{#each guild.text_channels}}
                            <option value="{{id}}" {{#if (eq id ../guild.combat_channel_id)}}selected{{/if}}>{{name}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "oronder.Combat-Channel-Label"}}</p>
            </div>
            <div class="form-group">
                <label for="combat_health_estimate">{{localize "oronder.Combat-Health-Estimate"}}</label>
                <div class="form-fields">
                    <select id="combat_health_estimate" name="combat_health_estimate" data-dtype="Number"
                            {{#unless combat_tracking_enabled}}disabled{{/unless}}>
                        {{#each combat_health_estimate_type}}
                            <option value="{{this}}" {{#if (eq this ../combat_health_estimate)}}selected{{/if}}>{{@key}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "oronder.Combat-Health-Estimate-Label"}}</p>
            </div>
            <button type="button" data-action="syncAll" {{#if buttons_disabled}}disabled{{/if}}>
                <i class="{{#if full_sync_active}}fa-solid fa-spinner fa-spin{{else}}fa-solid fa-rotate{{/if}}" inert></i>
                <span>{{#if full_sync_active}}{{localize "oronder.Full-Sync-Pending"}}{{else}}{{localize "oronder.Full-Sync"}}{{/if}}</span>
            </button>
            <button type="button" data-action="init" {{#if buttons_disabled}}disabled{{/if}}>
                <i class="{{#if init_active}}fa-solid fa-spinner fa-spin{{else}}fa-brands fa-discord{{/if}}" inert></i>
                <span>{{#if init_active}}{{localize "oronder.Init-Pending"}}{{else}}{{localize "oronder.Re-Init"}}{{/if}}</span>
            </button>
        </fieldset>
    {{else}}
        <fieldset>
            <legend>Discord</legend>
            <p class="hint">{{localize "oronder.No-Guild"}}</p>
            <button type="button" data-action="init" {{#if buttons_disabled}}disabled{{/if}}>
                <i class="{{#if init_active}}fa-solid fa-spinner fa-spin{{else}}fa-brands fa-discord{{/if}}" inert></i>
                <span>{{#if init_active}}{{localize "oronder.Init-Pending"}}{{else}}{{localize "oronder.Init"}}{{/if}}</span>
            </button>
        </fieldset>
    {{/if}}
</div>
